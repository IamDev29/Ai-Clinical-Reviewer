# ==============================================================================
# AI CLINICAL DOCUMENT REVIEWER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Clinical Document Reviewer"
API_V1_STR=/api/v1
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. CORS SETTINGS (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
# In production, set to your Vercel/Render frontend domain, e.g. ["https://my-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Use discrete parameters (Local / Docker Compose):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_reviewer

# OR provide a single managed connection string (e.g., Render, Railway, Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------------------
# 4. GEMINI AI EXTRACTION PIPELINE
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT PROCESSING CONFIGURATION
# ------------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=25
MIN_PDF_TEXT_LENGTH_THRESHOLD=50

# ------------------------------------------------------------------------------
# 6. CONTAINER STARTUP & MIGRATIONS
# ------------------------------------------------------------------------------
RUN_MIGRATIONS=true
SEED_SAMPLE_DATA=false

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite SPA)
# ------------------------------------------------------------------------------
# Base API URL used by the frontend to communicate with FastAPI v1 endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1
